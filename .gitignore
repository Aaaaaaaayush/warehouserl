# ============================================================
# .gitignore — WarehouseRL
# Excludes large binaries, local databases, and temporary caches
# while tracking pre-computed evaluation & dashboard artifacts.
# ============================================================

# ── Virtual environment ─────────────────────────────────────
.venv_wrl/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.Python

# ── Trained model checkpoints (large binaries — scp to server)
models/*.pt
models/*.pth

# ── MLflow local database & experiment runs ─────────────────
mlflow.db
mlruns/
.mlflow/

# ── IDE and OS files ─────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Python build artifacts ────────────────────────────────────
*.egg-info/
dist/
build/
.eggs/

# ── Test cache ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Notebook checkpoints ─────────────────────────────────────
.ipynb_checkpoints/

# ── Secrets (never commit these) ─────────────────────────────
.env
*.pem
*.key
