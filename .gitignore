# ============================================================
# .gitignore — WarehouseRL
# Excludes large binaries, training artifacts, and environment
# files that are machine-specific or regeneratable.
# ============================================================

# ── Virtual environment ─────────────────────────────────────
.venv_wrl/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.Python

# ── Trained model checkpoints (large binaries — scp to server)
models/*.pt
models/*.pth

# ── Training logs (MLflow artifacts — regeneratable)
logs/
mlruns/

# ── Episode recordings (generated by evaluation pipeline)
episodes/*.json
videos/*.mp4

# ── IDE and OS files ─────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Python build artifacts ────────────────────────────────────
*.egg-info/
dist/
build/
.eggs/

# ── Test cache ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Notebook checkpoints ─────────────────────────────────────
.ipynb_checkpoints/

# ── Secrets (never commit these) ─────────────────────────────
.env
*.pem
*.key
